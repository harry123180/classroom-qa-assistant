# ===== 必填：AI 模型（任何 OpenAI 相容 API 都可以）=====
# OpenAI 官方：LLM_BASE_URL 留空即可
# LiteLLM / 其他相容服務：填它的 /v1 網址
LLM_BASE_URL=https://ai.qianpro.shop/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=gpt-4o-mini

# ===== 必填：老師後台密碼（沒設定就無法進入 #/teacher）=====
TEACHER_PASSWORD=change-me

# ===== 選填：班級代碼（有設定的話學生要輸入才能提問）=====
CLASS_CODE=

# ===== 選填：資料庫 =====
# 留空 = 使用 SQLite（本機開發用，存在 data/qa.db）
# 部署到 Vercel 請設定 Postgres 連線字串（例如 Vercel 後台加 Neon，會自動帶入）
DATABASE_URL=
